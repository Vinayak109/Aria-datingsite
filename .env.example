# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ELEVENLABS_API_KEY: Studio-quality Indian voice via ElevenLabs Multilingual v2.
# On Vercel: Add this in Vercel Project Settings -> Environment Variables.
# Supports ELEVENLABS_API_KEY or ELEVEN_LABS_API_KEY or XI_API_KEY.
ELEVENLABS_API_KEY=""

# ELEVENLABS_VOICE_ID: Optional ElevenLabs voice ID.
# - "7wlfJf72PCt9FjPj0Beg": Nishi (Hindi Storyteller & Expressive Nuances)
# - "pFZP5JQG7iQjIQuC4Bku": Lily (Sweet, Soft Indian Rem - Works on ElevenLabs Free & Starter)
# - "cgSgspJ2msm6clMCkdW9": Jessica (Playful & Gentle Hindi)
ELEVENLABS_VOICE_ID="7wlfJf72PCt9FjPj0Beg"

